# ─────────────────────────────────────────────────────────────────────────────
# ChainScope – environment configuration
# Copy to .env.local and adjust. NEVER commit real keys. All variables below are
# read server-side only (no NEXT_PUBLIC_ prefix) – nothing here reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data mode ────────────────────────────────────────────────────────────────
# true  → every analysis uses the local, synthetic demo dataset, clearly
#         labelled "Demo Data" across the UI and reports.
# false → live blockchain data via the providers configured below.
DEMO_MODE=true

# ── Blockchain providers ─────────────────────────────────────────────────────
# Etherscan API V2 (one key for Ethereum, Base and BNB Chain).
# https://etherscan.io/apis  – note: some chains may require a paid plan.
ETHERSCAN_API_KEY=

# Blockscout explorers are used keyless as a fallback for Ethereum and Base.
BLOCKSCOUT_ETHEREUM_URL=https://eth.blockscout.com/api
BLOCKSCOUT_BASE_URL=https://base.blockscout.com/api

# JSON-RPC endpoints (balances, token balances, contract detection).
RPC_ETHEREUM_URL=https://ethereum-rpc.publicnode.com
RPC_BASE_URL=https://mainnet.base.org
RPC_BSC_URL=https://bsc-dataseed.bnbchain.org

# Maximum transfers fetched per category (native / token / internal) per analysis.
MAX_TRANSACTIONS=1000

# ── Pricing ──────────────────────────────────────────────────────────────────
# CoinGecko public API works without a key (rate limited). Optional demo/pro key.
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ── Persistence ──────────────────────────────────────────────────────────────
# PostgreSQL / Supabase connection string. When empty, ChainScope stores
# investigations, reports and cache in local JSON files under ./data/runtime.
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=
# Set to "true" for hosted Postgres that requires TLS (e.g. Supabase).
DATABASE_SSL=false

# ── Cache ────────────────────────────────────────────────────────────────────
# How long a wallet analysis is reused before a fresh fetch (minutes).
ANALYSIS_CACHE_TTL_MINUTES=30

# ── Security ─────────────────────────────────────────────────────────────────
# Requests per minute per client IP on the analysis API.
RATE_LIMIT_ANALYSIS_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
